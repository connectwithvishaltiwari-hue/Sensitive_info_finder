# Copy to .env (never commit .env). Placeholders only.
# mock (default, offline) or openai_compatible
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=replace-with-model-name
LLM_TIMEOUT=30
# Optional: where the SQLite file lives (default data/app.db)
# SID_DB_PATH=data/app.db

# Optional PostgreSQL database (set this on Vercel to use Supabase).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Admin key for protected settings endpoints. Use a long random secret in production.
# ADMIN_API_KEY=replace-with-a-long-random-secret
