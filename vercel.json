{
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{backend/app/static/**,evaluation/results/**}",
      "excludeFiles": "{data/**,docs/**,backend/tests/**,backend/.pytest_cache/**,evaluation/*.py}"
    }
  }
}
